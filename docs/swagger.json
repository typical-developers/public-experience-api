    "info": {
        "description": "This is the official, publicly accessible, API to get data in Typical Developers' experiences.\n# Notes\n- All dates and timestamps are returned in [ISO8601](https://en.wikipedia.org/wiki/ISO_8601) format and are set as a UTC timezone.\u003cbr\u003e\n---\n# Caching\nAll responses will return an `ETag` header, which is an MD5 hash of the response. You are able to use this hash to verify\nif there's updated content by supplying a `If-None-Match` in the requests header for the next request you make.\u003cbr\u003e\n- Status `200 - OK` will be returned if the resource has been updated.\n- Status `304 - Not Modified` will be returned if the resource has not been updated.\n---\n# Ratelimits\nAt the moment, the API does not have any rate limits. Please use the API responsibly by following good practices.\nAbuse detection will result in a indefinite ban from accessing the API. Please reach out in our [Discord Server](https.discord.gg/typical)\nif you have ran into this issue.",
        "title": "Typical Developers - Public Experience API",
        "version": ""
    },
    "externalDocs": {
        "description": "",
        "url": ""
    },
    "paths": {
        "/v1/oaklands/changelogs": {
            "get": {
                "description": "Fetch a list of changelog versions with their information.",
                "parameters": [
                    {
                        "description": "ETag to validate cached response.",
                        "in": "header",
                        "name": "If-None-Match",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "The direction to order by. This will use the changelog's date to order.",
                        "in": "query",
                        "name": "order_by",
                        "schema": {
                            "default": "desc",
                            "enum": [
                                "desc",
                                "asc"
                            ],
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "items": {
                                                "$ref": "#/components/schemas/Oaklands.V1.ChangelogVersion"
                                            },
                                            "type": "array"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/API.ErrorResponse"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/API.ErrorResponse"
                                }
                            }
                        },
                        "description": "Service Unavailable"
                    }
                },
                "tags": [
                    "Oaklands"
                ]
            }
        },
